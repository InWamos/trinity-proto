# ===========================
# Database Configuration
# ===========================
DATABASE_ADDRESS=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=my_database
DATABASE_USER=my_user
DATABASE_PASSWORD=my_password
DATABASE_SSL_MODE=disable
# options typically: disable, require, verify-ca, verify-full
REDIS_ADDRESS=172.20.0.4
REDIS_PORT=6379
REDIS_PASSWORD=secret123
REDIS_DB_AUTH="0" # Will be used in future if we need redis in another module

# ===========================
# Kafka Configuration
# ===========================
KAFKA_BROKERS=172.20.0.7:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# options typically: PLAINTEXT, SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
# options typically: PLAIN, SCRAM-SHA-256, SCRAM-SHA-512
# KAFKA_SASL_USERNAME=trinity
# KAFKA_SASL_PASSWORD=trinity_password
KAFKA_COMPRESSION_TYPE=snappy
# options typically: none, snappy, lz4, gzip, zstd
KAFKA_REQUEST_TIMEOUT_MS=30000

# ===========================
# Logging Configuration
# ===========================
LOGGING_LEVEL=debug
# options example: debug, info, warn, error


# ===========================
# Server Configuration
# ===========================
SERVER_ENVIRONMENT=DEVELOPMENT
# options example: DEVELOPMENT, PRODUCTION
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

SERVER_TRUSTED_PROXY=127.0.0.1
SERVER_ALLOWED_ORIGIN=http://localhost:3000